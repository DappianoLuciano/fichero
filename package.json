{
  "name": "fichero",
  "version": "1.1.0",
  "description": "Gestión de fichas",
  "main": "main/main.js",
  "scripts": {
    "dev:renderer": "npm --prefix renderer run dev",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:electron\"",
    "build:renderer": "npm --prefix renderer run build",
    "build": "npm run build:renderer && electron-builder",
    "dist": "npm run build:renderer && electron-builder --win",
    "release": "npm run build:renderer && electron-builder --win --publish always",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "electron-updater": "^6.8.3",
    "prisma": "^6.15.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^40.4.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.1",
    "png2icons": "^2.0.1",
    "sharp": "^0.34.5",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.recetario.app",
    "productName": "Fichero",
    "asar": false,
    "files": [
      "main/**/*",
      "renderer/dist/**/*",
      "node_modules/**/*",
      "node_modules/.prisma/**/*",
      "!node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "prisma/schema.prisma",
        "to": "prisma/schema.prisma"
      },
      {
        "from": "prisma/migrations",
        "to": "prisma/migrations"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Fichero"
    },
    "publish": {
      "provider": "github",
      "owner": "DappianoLuciano",
      "repo": "fichero",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist-electron"
    }
  }
}
